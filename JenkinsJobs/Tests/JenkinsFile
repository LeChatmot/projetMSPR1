def runTests() {
    environment {
        PYTHON_VENV = 'venv'
        NODE_VERSION = '18'
    }

    stages {
        stage('UnitTest Python Backend') {
            stages {
                stage('Setup Python environement') {
                    steps {
                        script {
                            sh """
                                python3 -m venv ${PYTHON_VENV}
                                source ${PYTHON_VENV}/bin/activate
                                pip install --upgrade pip
                                pip install -r HealthIABack/requirements.txt
                            """
                        }
                    }
                }
                stage('Run Python test') {
                    steps {
                        script {
                            sh """
                                source ${PYTHON_VENV}/bin/activate
                                cd HealthIABack
                                pytest --cov=./ --cov-report=xml:coverage.xml -v
                            """
                        }
                    }
                }
            }
        }

        stage('UnitTest Node Frontend') {
            stages {
                stage('Setup Node environement') {
                    steps {
                        script {
                            sh """
                                nvm install ${NODE_VERSION} || curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash
                                nvm use ${NODE_VERSION}
                                cd Frontend
                                npm install
                            """
                        }
                    }
                }
                stage('Run Node test') {
                    steps {
                        script {
                            sh """
                                cd Frontend
                                npm test -- --coverage --watchAll=false
                            """
                        }
                    }
                }
            }
        }

        stage('Aggregate Test Results') {
            steps {
                script {
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: false,
                        keepAll: true,
                        reportDir: 'Frontend/coverage/lcov-report',
                        reportFiles: 'index.html',
                        reportName: 'Frontend Coverage'
                    ])

                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: false,
                        keepAll: true,
                        reportDir: 'HealthIABack',
                        reportFiles: 'htmlcov/index.html',
                        reportName: 'Backend Coverage'
                    ])
                }
            }
        }
    }

    post {
        always {
            sh "rm -rf ${PYTHON_VENV}"
        }
        success {
            echo '✅ Tous les tests sont passés !'
            sendGithubNotification(
                status: 'success',
                message: 'All tests passed! ✅\n- Backend: ✅\n- Frontend: ✅'
            )
        }
        failure {
            echo '❌ Certains tests ont échoué'
            sendGithubNotification(
                status: 'failure',
                message: 'Tests failed! ❌\nPlease check the logs for details.'
            )
        }
    }
}

def sendGithubNotification(Map config) {
    script {
        if (env.CHANGE_ID) {
            withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')]) {
                def prNumber = env.CHANGE_ID
                def repo = env.GIT_URL.replace('https://github.com/', '').replace('.git', '')
                def message = """
                    **Tests ${config.status.toUpperCase()}** 🧪

                    ${config.message}

                    [View Analysis Details](${env.BUILD_URL})
                """.stripIndent()

                sh """
                    curl -X POST \\
                        -H "Authorization: token \${GITHUB_TOKEN}" \\
                        -H "Accept: application/vnd.github.v3+json" \\
                        https://api.github.com/repos/${repo}/issues/${prNumber}/comments \\
                        -d '{"body": "${message.replace('\n', '\\\\n').replace('"', '\\\\"')}"}'
                """
            }
        }
    }
}

runTests()
