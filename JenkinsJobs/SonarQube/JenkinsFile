def runSonarAnalysis() {
    environment {
        SONAR_PROJECT_KEY = 'Mspr'
        SONAR_HOST_URL = credentials('http://192.168.1.81:9000')
        SONAR_AUTH_TOKEN = credentials('SONAR_TOKEN')
    }

    stages {
        stage('Analyse SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=${SONAR_HOST_URL} \
                        -Dsonar.login=${SONAR_AUTH_TOKEN}
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    sleep(10)
                    def response = sh(script: '''
                        curl -s "http://192.168.1.81:9000/api/qualitygates/project_status?projectKey=Mspr"
                    ''', returnStdout: true).trim()

                    echo "Réponse Quality Gate: ${response}"

                    if (response.contains('"status":"ERROR"')) {
                        error("Quality Gate échoué !")
                    } else {
                        echo "✅ Quality Gate OK"
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Analyse SonarQube terminée avec succès'
            sendGithubNotification(
                status: 'success',
                message: 'SonarQube analysis passed! 🎉'
            )
        }
        failure {
            echo '❌ Echec de l\'analyse SonarQube'
            sendGithubNotification(
                status: 'failure',
                message: 'SonarQube analysis failed! ⚠️'
            )
        }
    }
}

def sendGithubNotification(Map config) {
    script {
        if (env.CHANGE_ID) {
            withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')]) {
                def prNumber = env.CHANGE_ID
                def repo = env.GIT_URL.replace('https://github.com/', '').replace('.git', '')
                def message = """
                    **SonarQube Analysis ${config.status.toUpperCase()}** 🔍

                    ${config.message}

                    [View Analysis Details](${env.BUILD_URL})
                """.stripIndent()

                sh """
                    curl -X POST \\
                        -H "Authorization: token \${GITHUB_TOKEN}" \\
                        -H "Accept: application/vnd.github.v3+json" \\
                        https://api.github.com/repos/${repo}/issues/${prNumber}/comments \\
                        -d '{"body": "${message.replace('\n', '\\\\n').replace('"', '\\\\"')}"}'
                """
            }
        }
    }
}

runSonarAnalysis()