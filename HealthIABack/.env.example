# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=healthia
DB_PASSWORD=
DB_NAME=health_ia_db

# --- Flask ---
# "127.0.0.1" en développement local, "0.0.0.0" dans Docker
FLASK_HOST=127.0.0.1

# --- Sécurité CORS ---
# Origines autorisées séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Intelligence Artificielle ---
# Clé API Mistral (console.mistral.ai) — obligatoire pour le Coach IA
MISTRAL_API_KEY=
